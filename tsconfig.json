{
  "compilerOptions": {
    "strict": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2017",
    "module": "esnext",
    "lib": ["DOM", "ES2019"],
    "types": ["google.analytics", "node"]
  }
}
